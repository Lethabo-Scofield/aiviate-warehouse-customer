{
  "buildCommand": "pnpm --filter @workspace/warehouse-ecommerce run build",
  "outputDirectory": "artifacts/warehouse-ecommerce/dist/public",
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/auth/:path*" },
    { "source": "/orders", "destination": "/api/orders" },
    { "source": "/orders/:path*", "destination": "/api/orders/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
