{
  "buildCommand": "pnpm --filter @workspace/warehouse-ecommerce run build && pnpm exec esbuild api/_lib/entry.ts --bundle --platform=node --format=cjs --outfile=api/_lib/server-bundle.cjs --external:pg-native",
  "outputDirectory": "artifacts/warehouse-ecommerce/dist/public",
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/index?__path=auth/:path*" },
    { "source": "/orders", "destination": "/api/index?__path=orders" },
    { "source": "/orders/:path*", "destination": "/api/index?__path=orders/:path*" },
    { "source": "/api/:path*", "destination": "/api/index?__path=api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
